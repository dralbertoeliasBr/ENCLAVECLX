class Slot4_ROTA:
    """Zona de transformação: Dados comprimidos → Destino final (DOCA)."""
    
    def __init__(self, janela_minutos=45):
        self.buffer_stopgo = {}
        self.janela = janela_minutos
        self.output = None
    
    def _avaliar_stopgo(self, hash_texto):
        """Stop&Go: bloqueia repetição dentro de janela."""
        agora = datetime.now()
     


        self.buffer_stopgo[hash_texto] = agora
        return {"acao": "GO"}
    
    def executar(self, entrada_compressao):
        """Decide rota final + aplica Stop&Go."""
        if not entrada_compressao:
            return None
        
        conteudo = entrada_compressao.get("conteudo", {})
        hash_hmac = conteudo.get("hmac", "")[:16]
        
        # Stop&Go
        decisao_stopgo = self._avaliar_stopgo(hash_hmac)
        if decisao_stopgo["acao"] == "STOP":
            print("[ROTA] 🛑 STOP — Repetição bloqueada por {} min".format(
                decisao_stopgo["minutos_restantes"]))
            return None
        
        # Decide box baseado em tipo
        tipo = conteudo.get("tipo", "GENERICO")
        if tipo == "ARQUIVAR":
            box = "01"
        elif tipo == "ESCREVER":
            box = "02"
        elif tipo == "FOTO":
            box = "03"
        elif tipo == "DESENHO":
            box = "03"
        else:
            box = "04"
        
        self.output = {
            "acao": "GO",
            "box": box,
            "tipo": tipo,
            "arquivo": entrada_compressao.get("nome"),
            "verificado": True,
            "hmac": hash_hmac,
        }
        
        return self.output

