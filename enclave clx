class ArquivistaIA:
    """Agente de catalogação contínua (background)."""
    
    def __init__(self, doca):
        self.doca = doca
        self.rodando = False
    
    def catalogar(self):
        """Cataloga arquivos do DOCA."""
        print("[ARQUIVISTA] 📚 Catalogando...")
        
        contagem = {}
        for hash_val, meta in self.doca.index.items():
            box = meta.get("box", "?")
            contagem[box] = contagem.get(box, 0) + 1
        
        resultado = {
            "total": len(self.doca.index),
            "por_box": contagem,
            "ts": datetime.now().isoformat(),
        }
        
        self.doca._log("CATALOGO: {}".format(json.dumps(resultado)))
        return resultado
    
    def start(self):
        """Inicia background thread."""
        self.rodando = True
        
        def loop():
            while self.rodando:
                time.sleep(300)  # 5 minutos
                self.catalogar()
        
        thread = threading.Thread(target=loop, daemon=True)
        thread.start()
        print("[ARQUIVISTA] 🟢 Iniciado em background")

