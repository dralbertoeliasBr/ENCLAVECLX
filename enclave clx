class DOCA:
    """Bunker de armazenamento local com integridade verificada."""
    
    def __init__(self):
        self.base = os.path.expanduser("~/Documents/ENCLAVE_DOCA")
        self.index_path = os.path.join(self.base, "_index.json")
        self.manifesto_path = os.path.join(self.base, "_manifesto.log")
        self.index = {}
        self._inicializar()
        self._carregar_index()
    
    def _inicializar(self):
        """Cria estrutura de pastas."""
        os.makedirs(self.base, exist_ok=True)
        
        # Cria Boxes
        for i in range(1, 9):
            box_dir = os.path.join(self.base, "BOX_{:02d}".format(i))
            os.makedirs(box_dir, exist_ok=True)
    
    def _carregar_index(self):
        """Carrega índice de arquivos."""
        if os.path.exists(self.index_path):
            try:
                with open(self.index_path, "r", encoding="utf-8") as f:
                    self.index = json.load(f)
            except:
                self.index = {}
    
    def _salvar_index(self):
        """Salva índice."""
        with open(self.index_path, "w", encoding="utf-8") as f:
            json.dump(self.index, f, indent=2, ensure_ascii=False)
    
    def _log(self, evento):
        """Registra evento em manifesto."""
        with open(self.manifesto_path, "a", encoding="utf-8") as f:
            f.write("[{}] {}\n".format(datetime.now().isoformat(), evento))
    
    def guardar(self, box, nome_arquivo, conteudo):
        """Armazena arquivo com verificação."""
        box_dir = os.path.join(self.base, "BOX_{:02d}".format(int(box)))
        caminho = os.path.join(box_dir, nome_arquivo)
        
        # Serializa conteúdo
        if isinstance(conteudo, dict):
            conteudo_str = json.dumps(conteudo, indent=2, ensure_ascii=False)
        else:
            conteudo_str = str(conteudo)
        
        # Calcula hash
        hash_conteudo = hashlib.sha256(conteudo_str.encode()).hexdigest()
        
        # Armazena
        try:
            with open(caminho, "w", encoding="utf-8") as f:
                f.write(conteudo_str)
            
            # Atualiza index
            self.index[hash_conteudo] = {
                "arquivo": nome_arquivo,
                "box": box,
                "caminho": caminho,
                "ts": datetime.now().isoformat(),
                "tamanho": os.path.getsize(caminho),
            }
            
            self._salvar_index()
            self._log("✅ GUARDADO | Box: {} | Arquivo: {} | Hash: {}".format(
                box, nome_arquivo, hash_conteudo[:12]))
            
            return {"ok": True, "hash": hash_conteudo, "caminho": caminho}
        
        except Exception as e:
            self._log("❌ ERRO | {}".format(str(e)))
            return {"ok": False, "erro": str(e)}

