class Slot3_COMPRESSAO:
    """Zona de transformação: Dados brutos → Comprimidos + Nomeados."""
    
    def __init__(self):
        self.output = None
    
    def _slug_semantico(self, texto, max_len=28):
        """Gera nome determinístico a partir do conteúdo."""
        
    def executar(self, entrada_llm):
        """Comprime e nomeia."""
        if not entrada_llm:
            return None
        
        resposta = entrada_llm.get("response", "")
        titulo = self._slug_semantico(resposta)
        
        # Calcula compressão simulada
        tamanho_original = len(json.dumps(entrada_llm, ensure_ascii=False).encode())
        tamanho_comprimido = int(tamanho_original * 0.7)  # Simula 30% compressão
        
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        hash_curto = entrada_llm.get("hmac", "")[:10]
        nome_arquivo = "{}_{}_{}.json".format(ts, titulo, hash_curto)
        
        self.output = {
            "nome": nome_arquivo,
            "titulo": titulo,
            "conteudo": entrada_llm,
            "tamanho_original": tamanho_original,
            "tamanho_comprimido": tamanho_comprimido,
            "compression_ratio": round(tamanho_comprimido / tamanho_original, 2),
            "ts": ts,
        }
        
        return self.output

